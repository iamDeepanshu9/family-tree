{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Family tree data",
  "type": "object",
  "required": ["family", "members"],
  "additionalProperties": false,
  "properties": {
    "family": {
      "type": "object",
      "required": ["title", "rootId"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "titleHindi": { "type": "string" },
        "rootId": { "type": "string", "minLength": 1 }
      }
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/member" }
    }
  },
  "$defs": {
    "year": { "type": ["integer", "null"], "minimum": 1000, "maximum": 2200 },
    "spouse": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "nameHindi": { "type": "string" },
        "birthYear": { "$ref": "#/$defs/year" },
        "deathYear": { "$ref": "#/$defs/year" },
        "isDeceased": { "type": "boolean" },
        "branch": { "type": "string" },
        "photo": { "type": ["string", "null"] },
        "bio": { "type": "string" }
      }
    },
    "member": {
      "type": "object",
      "required": ["id", "name", "parentId"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "nameHindi": { "type": "string" },
        "gender": { "enum": ["M", "F"] },
        "parentId": { "type": ["string", "null"] },
        "order": { "type": "integer", "minimum": 1 },
        "birthYear": { "$ref": "#/$defs/year" },
        "deathYear": { "$ref": "#/$defs/year" },
        "photo": { "type": ["string", "null"] },
        "bio": { "type": "string" },
        "spouses": { "type": "array", "items": { "$ref": "#/$defs/spouse" } }
      }
    }
  }
}
